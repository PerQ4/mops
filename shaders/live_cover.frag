#include <flutter/runtime_effect.glsl>

// «Живая обложка» — свет по краям обложки полноэкранного плеера (задача 8.2).
//
// Сам дрейф картинки шейдером не сделать: шевелить нужно фотографию, а
// фрагментный шейдер её не видит — она нарисована под ним. Поэтому дрейф делает
// композитный `Transform` (см. `lib/widgets/live_cover.dart`), а шейдер отвечает
// за то, что иначе стоило бы перерисовки обложки на CPU каждый кадр: мягкий свет
// по краям, который меняет яркость и оттенок вместе с уровнем звука.
//
// Стоимость на пиксель маленькая: два `length` (расстояние до скруглённого
// прямоугольника), две `pow` и четыре `sin`/`cos`, остальное — арифметика.
// Обложка — квадрат в несколько сотен пикселей, но она на экране всё время, пока
// играет музыка, поэтому шума, `atan` и циклов здесь нет намеренно.
//
// Цвет выводится предумноженным на альфу: так его ждёт смешивание Skia, иначе
// свет на краях выходил бы ярче задуманного (проверено на предпросмотре).

uniform vec2 uSize;     // сторона области в тех же единицах, что FlutterFragCoord
uniform float uTime;    // секунды с начала показа (на паузе стоят)
uniform float uLevel;   // уровень звука 0..1, уже сглаженный
uniform vec3 uColorA;   // цвет свечения 1 — основной цвет палитры
uniform vec3 uColorB;   // цвет свечения 2 — акцентный
uniform float uRadius;  // радиус скругления обложки, px

out vec4 fragColor;

void main() {
  vec2 halfSize = uSize * 0.5;
  vec2 p = FlutterFragCoord().xy - halfSize;

  // Расстояние до края скруглённого прямоугольника: отрицательное внутри.
  vec2 q = abs(p) - (halfSize - vec2(uRadius));
  float sd = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - uRadius;

  float side = max(min(uSize.x, uSize.y), 1.0);

  // Дыхание: медленная волна, не привязанная к темпу. Период около 15 секунд —
  // заметно, но не превращается в пульсацию, которая спорит с музыкой.
  float breath = 0.5 + 0.5 * sin(uTime * 0.42);

  // Ширина полосы света: десятая часть меньшей стороны. Узкая полоса читается
  // как подсветка из-под обложки, широкая — как цветной туман по всему кадру.
  float band = side * (0.10 + 0.022 * breath + 0.045 * uLevel);
  float edge = clamp(1.0 + sd / band, 0.0, 1.0);
  // Степень собирает свет ближе к кромке: линейный спад читался как «обложку
  // подкрасили», а не как свет из-под неё.
  edge = pow(edge, 2.6);

  // Тонкая горячая кромка у самого края — она читается как подсветка, а не как
  // размытое пятно.
  float rim = clamp(1.0 + sd / (side * 0.010), 0.0, 1.0);
  rim = pow(rim, 3.0);

  // Оттенок по краю: два цвета палитры, а ось медленно обходит обложку, поэтому
  // свет не стоит на месте даже в тишине.
  vec2 dir = p / max(length(p), 1.0);
  vec2 axis = vec2(cos(uTime * 0.09), sin(uTime * 0.09));
  float toward = dot(dir, axis) * 0.5 + 0.5;
  float mixv = 0.5 + 0.5 * sin((dir.x * 0.8 + dir.y * 0.6) * 2.0 + uTime * 0.12);
  vec3 color = mix(uColorA, uColorB, mixv);
  // Кромка уходит в белый: так свет читается как источник, а не как цветная
  // плёнка поверх картинки.
  color = mix(color, vec3(1.0), rim * (0.25 + 0.45 * uLevel));

  // Яркость: спокойная база, дыхание и звук. Уровень весит больше всего —
  // обложка должна отзываться на музыку, а не жить своей жизнью.
  float gain = (0.05 + 0.05 * breath + 0.46 * uLevel) * (0.85 + 0.28 * toward);

  float alpha = edge * gain +
      rim * (0.05 + 0.32 * uLevel) * (0.7 + 0.3 * toward);
  alpha = clamp(alpha, 0.0, 0.55);

  fragColor = vec4(color * alpha, alpha);
}
