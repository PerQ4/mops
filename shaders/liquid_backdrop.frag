#include <flutter/runtime_effect.glsl>

// Liquid backdrop — «жидкий» фон полноэкранного плеера.
//
// Идея взята у shredos67/swiftify (`LiquidBackdrop.qml`, `shaders/`): фон плеера —
// медленно текущая жидкость из цветов обложки. Код свой: их GLSL написан под
// Qt/QRhi, здесь — runtime effect Flutter, где доступны только float-униформы и
// FlutterFragCoord().
//
// Дешевизна намеренно важнее красоты: хеш без sin (на слабой машине sin на
// каждый пиксель заметно дороже), три октавы вместо шести, пять вызовов fbm на
// пиксель. Анимацию двигает не шейдер, а uTime: время передаёт виджет, и на
// паузе оно не растёт (см. `lib/widgets/liquid_backdrop.dart`), поэтому кадры на
// простое не тратятся.

uniform vec2 uSize;   // размер области в тех же единицах, что FlutterFragCoord
uniform float uTime;  // секунды с начала показа (на паузе стоит)
uniform vec3 uColorA; // цвет 1 палитры (обложки или темы)
uniform vec3 uColorB; // цвет 2 — обязательно другой: три одинаковых дают плоскую заливку
uniform vec3 uColorC; // цвет 3
uniform float uFlowSpeed; // множитель скорости течения (настройка «Скорость течения»)
uniform float uBlobScale; // множитель размера пятен (настройка «Масштаб пятен»)

out vec4 fragColor;

// Хеш без transcendentals: только умножение, сложение и fract.
float hash(vec2 p) {
  p = fract(p * vec2(123.34, 456.21));
  p += dot(p, p + 45.32);
  return fract(p.x * p.y);
}

float valueNoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  // Кубическое сглаживание: границы ячеек не видны.
  vec2 u = f * f * (3.0 - 2.0 * f);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Три октавы: одной мало — видны «клетки», больше — не оправдано по цене.
float fbm(vec2 p) {
  float sum = 0.0;
  float amp = 0.5;
  for (int i = 0; i < 3; i++) {
    sum += amp * valueNoise(p);
    p *= 2.07;
    amp *= 0.5;
  }
  return sum;
}

void main() {
  vec2 uv = FlutterFragCoord().xy / uSize;
  // Растягиваем по горизонтали по пропорции области: круглая жидкость в широком
  // окне выглядела бы сплюснутой. Масштаб пятен из настроек задаёт, насколько
  // крупными выходят волокна: меньше единицы — мельче и чаще, больше — крупнее.
  vec2 p = vec2(uv.x * (uSize.x / max(uSize.y, 1.0)), uv.y) * (1.8 * uBlobScale);
  // Скорость течения — множитель времени: 1.0 оставляет прежнюю ползучесть.
  float t = uTime * uFlowSpeed;

  // Доменное искажение: шум смещает сам себя, поэтому вместо «облаков»
  // получаются тянущиеся волокна — и они ползут со временем. Коэффициенты
  // подобраны по замеру: при прежних 0.045/0.032 ползучесть была незаметна на
  // глаз (около трёх единиц яркости в секунду), при этих — видна.
  vec2 q = vec2(
      fbm(p + vec2(0.0, t * 0.13)),
      fbm(p + vec2(5.2, 1.3) - vec2(t * 0.21, 0.0)));
  float f = fbm(p + 2.6 * q + vec2(1.7, 9.2));

  // Три цвета палитры разложены по полю, как в стиле «Градиент»: каждый
  // занимает свою долю, поэтому фон читается «в цвете трека», а не уходит в
  // один усреднённый тон. Диапазон шума узкий, поэтому растягиваем его
  // clamp-ом: s задаёт «полосу», u — какую из двух дальних полос занять.
  float s = clamp((f - 0.15) / 0.60, 0.0, 1.0);
  float u = clamp((q.y - 0.20) / 0.55, 0.0, 1.0);
  vec3 color = uColorA * (1.0 - s) +
               uColorB * (s * (1.0 - u)) +
               uColorC * (s * u);

  // Виньетка: края темнее, середина «подсвечена» — как подсветка под жидкостью.
  // Ослаблена: она не должна съедать цвета обложки.
  float vignette = smoothstep(1.25, 0.2, length(uv - 0.5));
  color *= 0.88 + 0.22 * vignette;

  fragColor = vec4(color, 1.0);
}
